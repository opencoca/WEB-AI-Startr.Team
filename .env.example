# ==============================================================================
# Startr.Team API Key Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (e.g., `cp .env.example .env`)
# 2. Add your API keys below
# 3. Use `make verify-api-keys` to test if your keys are working
# 4. If using Docker, run `make docker-update-and-restart` to update the container
# ==============================================================================

# OpenAI API Key (Required)
# Get this key from: https://platform.openai.com/account/api-keys
export OPENAI_API_KEY=""

# Groq API Key (Optional - for models like LLAMA)
# Get this key from: https://console.groq.com/keys
export GROQ_API_KEY=""

# ==============================================================================
# Additional Configuration Options (Advanced)
# ==============================================================================

# Base URL for OpenAI API (Optional - only needed for custom endpoints)
# export OPENAI_API_BASE="https://api.openai.com/v1"

# Organization ID for OpenAI API (Optional)
# export OPENAI_ORGANIZATION=""